{
  "name": "@aws-cdk/graduate-module",
  "version": "0.0.0",
  "private": true,
  "description": "Automates graduation of an @aws-cdk/aws-<service>-alpha module into aws-cdk-lib",
  "bin": {
    "graduate-module": "bin/graduate-module"
  },
  "scripts": {
    "build": "tsc --build",
    "build+test": "npm run build && npm run test",
    "lint": "eslint --no-error-on-unmatched-pattern lib test",
    "test": "jest --passWithNoTests --coverage=false",
    "watch": "tsc --build -w tsconfig.json"
  },
  "dependencies": {
    "ts-morph": "~27.0.2"
  },
  "devDependencies": {
    "@aws-cdk/cdk-build-tools": "0.0.0",
    "@aws-cdk/eslint-config": "0.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "jest": "^29",
    "ts-jest": "^29",
    "typescript": "~5.9.3"
  },
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "ubergen": {
    "exclude": true
  }
}