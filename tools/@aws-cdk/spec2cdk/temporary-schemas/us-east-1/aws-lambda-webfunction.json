{
    "typeName": "AWS::Lambda::WebFunction",
    "description": "Resource Type definition for AWS::Lambda::WebFunction. Creates a Lambda Web function container.",
    "properties": {
        "FunctionName": {
            "type": "string",
            "description": "The name of the function.",
            "minLength": 1,
            "maxLength": 256
        },
        "FunctionArn": {
            "type": "string",
            "description": "The Amazon Resource Name (ARN) of the function.",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^arn:(aws[a-z-]*):lambda:[a-z0-9-]+:[0-9]{12}:web-function/.+$"
        },
        "State": {
            "type": "string",
            "description": "The current state of the function.",
            "enum": ["Pending", "Active", "Failed", "Deleting"]
        },
        "StateReason": {
            "type": "string",
            "description": "The reason for the function's current state."
        },
        "CreatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the function was created."
        },
        "UpdatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the function was last updated."
        },
        "Tags": {
            "type": "array",
            "description": "A list of tags to apply to the function.",
            "items": {
                "$ref": "#/definitions/Tag"
            },
            "uniqueItems": true,
            "insertionOrder": false
        }
    },
    "definitions": {
        "Tag": {
            "type": "object",
            "description": "A key-value pair to associate with the function.",
            "properties": {
                "Key": {
                    "type": "string",
                    "description": "The tag key.",
                    "minLength": 1,
                    "maxLength": 128
                },
                "Value": {
                    "type": "string",
                    "description": "The tag value.",
                    "minLength": 0,
                    "maxLength": 256
                }
            },
            "required": ["Key", "Value"],
            "additionalProperties": false
        }
    },
    "required": ["FunctionName"],
    "additionalProperties": false,
    "primaryIdentifier": ["/properties/FunctionArn"],
    "additionalIdentifiers": [["/properties/FunctionName"]],
    "readOnlyProperties": [
        "/properties/FunctionArn",
        "/properties/State",
        "/properties/StateReason",
        "/properties/CreatedAt",
        "/properties/UpdatedAt"
    ],
    "createOnlyProperties": [
        "/properties/FunctionName"
    ],
    "tagging": {
        "taggable": true,
        "tagOnCreate": true,
        "tagUpdatable": true,
        "cloudFormationSystemTags": true,
        "tagProperty": "/properties/Tags",
        "permissions": [
            "lambda:TagResource",
            "lambda:UntagResource",
            "lambda:ListTags"
        ]
    },
    "handlers": {
        "create": {
            "permissions": [
                "lambda:CreateWebFunction",
                "lambda:GetWebFunction",
                "lambda:TagResource",
                "lambda:ListTags"
            ]
        },
        "read": {
            "permissions": [
                "lambda:GetWebFunction",
                "lambda:ListTags"
            ]
        },
        "update": {
            "permissions": [
                "lambda:GetWebFunction",
                "lambda:TagResource",
                "lambda:UntagResource",
                "lambda:ListTags"
            ]
        },
        "delete": {
            "permissions": [
                "lambda:DeleteWebFunction",
                "lambda:GetWebFunction",
                "lambda:ListTags"
            ]
        },
        "list": {
            "permissions": [
                "lambda:ListWebFunctions"
            ]
        }
    }
}
