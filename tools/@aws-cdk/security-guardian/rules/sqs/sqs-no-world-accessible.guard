#
#####################################
##          SQS GUARD RULES         ##
#####################################
# Rule: SQS_NO_WORLD_ACCESSIBLE
# Service: Amazon Simple Queue Service (SQS)
# Coverage: World Accessibility

let sqs_queue_policies = Resources.*[
  Type == 'AWS::SQS::QueuePolicy'
  Metadata.guard.SuppressedRules not exists or
  Metadata.guard.SuppressedRules.* != "SQS_NO_WORLD_ACCESSIBLE"
]

# SQS queues should not be world accessible via queue policies
rule SQS_NO_WORLD_ACCESSIBLE when %sqs_queue_policies !empty {
    %sqs_queue_policies {
        Properties.PolicyDocument.Statement[*] {
            when Effect == "Allow" {
                when Principal exists {
                    when Principal is_string {
                        Principal != "*"
                            <<##ERROR:SQS queue policy must not be world-accessible. Remove '*' from Principal and scope to specific accounts or roles.##>>
                    }
                    when Principal.AWS is_string {
                        Principal.AWS != "*"
                            <<##ERROR:SQS queue policy must not be world-accessible. Remove '*' from Principal and scope to specific accounts or roles.##>>
                    }
                    # Only string elements are checked - intrinsic functions (maps like Fn::GetAtt) are skipped
                    when Principal.AWS is_list {
                        Principal.AWS[*][ this is_string ] != "*"
                            <<##ERROR:SQS queue policy must not be world-accessible. Remove '*' from Principal and scope to specific accounts or roles.##>>
                    }
                }
            }
        }
    }
}
