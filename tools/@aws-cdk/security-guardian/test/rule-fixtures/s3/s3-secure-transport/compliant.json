{
  "Description": "S3_SECURE_TRANSPORT passes: the Deny statement denies requests that do not use HTTPS",
  "Resources": {
    "SecureTransportBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": "example-bucket",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": { "AWS": "*" },
              "Action": "s3:*",
              "Resource": ["arn:aws:s3:::example-bucket", "arn:aws:s3:::example-bucket/*"],
              "Condition": {
                "Bool": { "aws:SecureTransport": "false" }
              }
            }
          ]
        }
      }
    }
  }
}
