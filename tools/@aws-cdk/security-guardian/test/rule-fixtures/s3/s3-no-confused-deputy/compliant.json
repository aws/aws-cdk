{
  "Description": "S3_NO_CONFUSED_DEPUTY passes: the service principal is scoped to the source account",
  "Resources": {
    "ScopedServiceBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": "example-bucket",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "logging.s3.amazonaws.com" },
              "Action": "s3:PutObject",
              "Resource": "arn:aws:s3:::example-bucket/*",
              "Condition": {
                "StringEquals": { "aws:SourceAccount": "123456789012" }
              }
            }
          ]
        }
      }
    }
  }
}
