{
  "Description": "REDSHIFT_ENCRYPTION_ENABLED fires: the cluster disables encryption",
  "Resources": {
    "UnencryptedCluster": {
      "Type": "AWS::Redshift::Cluster",
      "Properties": {
        "ClusterType": "single-node",
        "NodeType": "ra3.xlplus",
        "DBName": "example",
        "MasterUsername": "admin",
        "Encrypted": false
      }
    }
  }
}
