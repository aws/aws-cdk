{
  "Description": "IAM_NO_WORLD_ACCESSIBLE_TRUST_POLICY fires: any AWS principal can assume the role",
  "Resources": {
    "WorldAssumableRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "AWS": "*" },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    }
  }
}
