{
  "Description": "IAM_NO_WORLD_ACCESSIBLE_TRUST_POLICY passes: only one named role can assume the role",
  "Resources": {
    "ScopedTrustRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "AWS": "arn:aws:iam::123456789012:role/TrustedRole" },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    }
  }
}
