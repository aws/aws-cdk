{
  "Description": "SQS_NO_WORLD_ACCESSIBLE fires: the queue policy lets any AWS principal send messages",
  "Resources": {
    "WorldSendableQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": ["https://sqs.us-west-2.amazonaws.com/123456789012/example-queue"],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "AWS": "*" },
              "Action": "sqs:SendMessage",
              "Resource": "arn:aws:sqs:us-west-2:123456789012:example-queue"
            }
          ]
        }
      }
    }
  }
}
