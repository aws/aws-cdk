{
  "Description": "SQS_NO_WORLD_ACCESSIBLE_INLINE fires: the inline queue policy lets any AWS principal send messages",
  "Resources": {
    "WorldSendableQueueInlinePolicy": {
      "Type": "AWS::SQS::QueueInlinePolicy",
      "Properties": {
        "Queue": "https://sqs.us-west-2.amazonaws.com/123456789012/example-queue",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "AWS": "*" },
              "Action": "sqs:SendMessage",
              "Resource": "arn:aws:sqs:us-west-2:123456789012:example-queue"
            }
          ]
        }
      }
    }
  }
}
