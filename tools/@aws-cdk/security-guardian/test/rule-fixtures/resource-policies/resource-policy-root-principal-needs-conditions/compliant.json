{
  "Description": "RESOURCE_POLICY_ROOT_PRINCIPAL_NEEDS_CONDITIONS passes: an ArnEquals condition limits the trusted account to one role",
  "Resources": {
    "ConditionedRootBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": "example-bucket",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "AWS": "arn:aws:iam::123456789012:root" },
              "Action": "s3:GetObject",
              "Resource": "arn:aws:s3:::example-bucket/*",
              "Condition": {
                "ArnEquals": { "aws:PrincipalArn": "arn:aws:iam::123456789012:role/Reader" }
              }
            }
          ]
        }
      }
    }
  }
}
