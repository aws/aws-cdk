  "IsVpcDiscovered5CA36520": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\nconst { EC2Client, GetIpamResourceCidrsCommand } = require('@aws-sdk/client-ec2');\nexports.handler = async (event) => {\n  if (event.RequestType === 'Delete') return { IsComplete: true };\n  const res = await new EC2Client().send(new GetIpamResourceCidrsCommand({\n    IpamScopeId: event.ResourceProperties.IpamScopeId,\n    ResourceId: event.ResourceProperties.VpcId,\n  }));\n  return { IsComplete: res.IpamResourceCidrs.length > 0 };\n};\n  "
    },
    "Handler": "index.handler",
    "MemorySize": 256,
    "Role": {
     "Fn::GetAtt": [
      "IsVpcDiscoveredServiceRoleE1EC320B",
      "Arn"
     ]
    },
    "Runtime": "nodejs24.x",
    "Timeout": 30
   },
   "DependsOn": [
