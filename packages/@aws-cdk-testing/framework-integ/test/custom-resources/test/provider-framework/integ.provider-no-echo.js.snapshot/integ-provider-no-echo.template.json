  "LogChecker145EDFD3": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\n    const { CloudWatchLogsClient, FilterLogEventsCommand } = require('@aws-sdk/client-cloudwatch-logs');\n    const client = new CloudWatchLogsClient({});\n    exports.handler = async () => {\n      let redacted = false;\n      let secret = false;\n      let nextToken;\n      do {\n        let page;\n        try {\n          page = await client.send(new FilterLogEventsCommand({ logGroupName: process.env.LOG_GROUP, nextToken }));\n        } catch (e) {\n          if (e.name === 'ResourceNotFoundException') { return 'no-log-group'; }\n          throw e;\n        }\n        for (const event of page.events ?? []) {\n          if (event.message.includes('redacted')) { redacted = true; }\n          if (event.message.includes(process.env.SECRET)) { secret = true; }\n        }\n        nextToken = page.nextToken;\n      } while (nextToken);\n      return (redacted ? 'redacted' : 'no-redacted-line') + '/' + (secret ? 'secret-logged' : 'no-secret');\n    };"
    },
    "Environment": {
     "Variables": {
      "LOG_GROUP": {
       "Fn::GetAtt": [
        "myproviderframeworkonEventLogRetentionA3431778",
        "LogGroupName"
       ]
      },
      "SECRET": "secret-value"
     }
    },
    "Handler": "index.handler",
    "Role": {
     "Fn::GetAtt": [
      "LogCheckerServiceRoleEF36F89D",
      "Arn"
     ]
    },
    "Runtime": "nodejs22.x",
    "Timeout": 60
   },
   "DependsOn": [
    "LogCheckerServiceRoleEF36F89D"
   ]
  },
