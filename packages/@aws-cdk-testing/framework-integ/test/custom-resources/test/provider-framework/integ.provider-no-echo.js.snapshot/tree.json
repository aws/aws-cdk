\n          let marker = false;\n          let nextToken;\n          try {\n            do {\n              const page = await client.send(new FilterLogEventsCommand({ logGroupName, nextToken }));\n              for (const event of page.events ?? []) {\n                // with the JSON log format, the logged text is the record's message field\n                let text = event.message;\n                try { const record = JSON.parse(text); if (typeof record.message === 'string') { text = record.message; } } catch { }\n                if (text.includes(process.env.MARKER)) { marker = true; }\n                if (event.message.includes(process.env.SECRET) || text.includes(process.env.SECRET)) { secret = true; }\n              }\n              nextToken = page.nextToken;\n            } while (nextToken);\n          } catch (e) {\n            if (e.name !== 'ResourceNotFoundException') { throw e; }\n          }\n          markerEverywhere = markerEverywhere && marker;\n        }\n        return (markerEverywhere ? 'marker-found' : 'marker-missing') + '/' + (secret ? 'secret-logged' : 'no-secret');\n      };"},"environment":{"variables":{"LOG_GROUPS":{"Fn::Join":["",["[\"",{"Fn::GetAtt":["myproviderframeworkonEventLogRetentionA3431778","LogGroupName"]},"\",\"",{"Fn::GetAtt":["myasyncproviderframeworkonEventLogRetention70E423B5","LogGroupName"]},"\",\"",{"Fn::GetAtt":["myasyncproviderframeworkisCompleteLogRetentionC374A742","LogGroupName"]},"\"]"]]},"MARKER":"\"mySecret\": \"*****\"","SECRET":"secret-value"}},"handler":"index.handler","role":{"Fn::GetAtt":["LogCheckerServiceRoleEF36F89D","Arn"]},"runtime":"nodejs22.x","timeout":60}}},"inlinePolicyAddedToExecutionRole-0":{"id":"inlinePolicyAddedToExecutionRole-0","path":"integ-provider-no-echo/LogChecker/inlinePolicyAddedToExecutionRole-0","constructInfo":{"fqn":"aws-cdk-lib.aws_iam.Policy","version":"0.0.0"},"children":{"Resource":{"id":"Resource","path":"integ-provider-no-echo/LogChecker/inlinePolicyAddedToExecutionRole-