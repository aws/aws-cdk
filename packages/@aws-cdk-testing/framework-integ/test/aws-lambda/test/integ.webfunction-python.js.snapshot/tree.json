esource","path":"WebFunctionPythonStack/Signer/Resource","constructInfo":{"fqn":"aws-cdk-lib.CfnResource","version":"0.0.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::Lambda::Function","aws:cdk:cloudformation:logicalId":"Signer046C0E68","aws:cdk:cloudformation:props":{"code":{"zipFile":"\nconst crypto = require('crypto');\nconst https = require('https');\nconst hash = (data) => crypto.createHash('sha256').update(data).digest('hex');\nconst hmac = (key, data) => crypto.createHmac('sha256', key).update(data).digest();\nexports.handler = async ({ url }) => {\n  const { hostname, pathname } = new URL(url);\n  const region = process.env.AWS_REGION;\n  const service = 'lambda';\n  const amzDate = new Date().toISOString().replace(/[:-]|\\.\\d{3}/g, '');\n  const date = amzDate.slice(0, 8);\n  const payloadHash = hash('');\n  const headers = {\n    'host': hostname,\n    'x-amz-content-sha256': payloadHash,\n    'x-amz-date': amzDate,\n    'x-amz-security-token': process.env.AWS_SESSION_TOKEN,\n  };\n  const names = Object.keys(headers).sort();\n  const canonical = ['GET', pathname || '/', '', ...names.map((n) => n + ':' + headers[n]), '', names.join(';'), payloadHash].join('\\n');\n  const scope = date + '/' + region + '/' + service + '/aws4_request';\n  const toSign = ['AWS4-HMAC-SHA256', amzDate, scope, hash(canonical)].join('\\n');\n  let key = hmac('AWS4' + process.env.AWS_SECRET_ACCESS_KEY, date);\n  for (const part of [region, service, 'aws4_request']) { key = hmac(key, part); }\n  const signature = crypto.createHmac('sha256', key).update(toSign).digest('hex');\n  headers.authorization = 'AWS4-HMAC-SHA256 Credential=' + process.env.AWS_ACCESS_KEY_ID + '/' + scope +\n    ', SignedHeaders=' + names.join(';') + ', Signature=' + signature;\n  const { status, body } = await new Promise((resolve, reject) => {\n    https.get({ hostname, path: pathname || '/', headers }, (res) => {\n      let data = '';\n      res.on('data', (chunk) => { data += chunk; });\n      res.on('end', () => resolve({ status: res.statusCode, body: data }));\n    }).on('error', reject);\n  });\n  return { status, body };\n};\n"},"handler":"index.handler","role":{"Fn::GetAtt":["SignerServiceRole18A0DCD3","Arn"]},"runtime":"nodejs22.x","timeout":30}}},"LogGroup":{"id":"LogGroup","path":"WebFunctionPythonStack/Signer/LogGroup","constructInfo":{"fqn":"aws-cdk-lib.Resource","version":"0.0.0"},"children":{"Resource":{"id":"Resource","path":"WebFunctionPythonStack/Signer/LogGroup/Resource","constructInfo":{"fqn":"aws-cdk-lib.aws_logs.CfnLogGroup","version":"0.0.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::Logs::LogGroup","aws:cdk:cloudformation:logicalId":"SignerLogGroup0DE99B5E","aws:cdk:cloudformation:props":{"logGroupName":{"Fn::Join":["",["/aws/lambda/",{"Ref":"Signer046C0E68"}]]},"retentionInDays":731}}}}}}},"Exports":{"id":"Exports","path":"WebFunctionPythonStack/Exports","constructInfo":{"fqn":"constructs.Construct","version":"10.8.1"},"children":{"Output{\"Ref\":\"Signer046C0E68\"}":{"id":"Output{\"Ref\":\"Signer046C0E68\"}","path":"WebFunctionPythonStack/Exports/Output{\"Ref\":\"Signer046C0E68\"}","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"0.0.0"}},"Output{\"Fn::GetAtt\":[\"DefaultEntryPointEndpointD1FC4D61\",\"DomainName\"]}":{"id":"Output{\"Fn::GetAtt\":[\"DefaultEntryPointEndpointD1FC4D61\",\"DomainName\"]}","path":"WebFunctionPythonStack/Exports/Output{\"Fn::GetAtt\":[\"DefaultEntryPointEndpointD1FC4D61\",\"DomainName\"]}","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"0.0.0"}},"Output{\"Fn::GetAtt\":[\"CustomEntryPointEndpointFC08AB16\",\"DomainName\"]}":{"id":"Output{\"Fn::GetAtt\":[\"CustomEntryPointEndpointFC08AB16\",\"DomainName\"]}","path":"WebFunctionPythonStack/Exports/Output{\"Fn::GetAtt\":[\"CustomEntryPointEndpointFC08AB16\",\"DomainName\"]}","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"0.0.0"}}}},"BootstrapVersion":{"id":"BootstrapVersion","path":"WebFunctionPythonStack/BootstrapVersion","