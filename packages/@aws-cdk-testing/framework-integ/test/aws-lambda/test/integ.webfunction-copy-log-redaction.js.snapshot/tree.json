vent of page.events ?? []) {\n          if (event.message.includes('\"Configuration\": \"*****\"')) { redacted = true; }\n          if (event.message.includes(process.env.SECRET)) { secret = true; }\n        }\n        nextToken = page.nextToken;\n      } while (nextToken);\n      return (redacted ? 'redacted' : 'no-redacted-configuration') + '/' + (secret ? 'secret-logged' : 'no-secret');\n    };"},"environment":{"variables":{"LOG_GROUP":{"Ref":"CopyLogGroup921A8ED8"},"SECRET":"webfunction-copy-redaction-secret"}},"handler":"index.handler","role":{"Fn::GetAtt":["LogCheckerServiceRoleEF36F89D","Arn"]},"runtime":"nodejs22.x","timeout":60}}},"LogGroup":{"id":"LogGroup","path":"WebFunctionCopyLogRedactionStack/LogChecker/LogGroup","constructInfo":{"fqn":"aws-cdk-lib.aws_logs.LogGroup","version":"0.0.0"},"children":{"Resource":{"id":"Resource","path":"WebFunctionCopyLogRedactionStack/LogChecker/LogGroup/Resource","constructInfo":{"fqn":"aws-cdk-lib.aws_logs.CfnLogGroup","version":"0.0.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::Logs::LogGroup","aws:cdk:cloudformation:logicalId":"LogCheckerLogGroupCD8C95C0","aws:cdk:cloudformation:props":{"logGroupName":{"Fn::Join":["",["/aws/lambda/",{"Ref":"LogChecker145EDFD3"}]]},"retentionInDays":731}}}}}}},"Exports":{"id":"Exports","path":"WebFunctionCopyLogRedactionStack/Exports","constructInfo":{"fqn":"constructs.Construct","version":"10.8.1"},"children":{"Output{\"Ref\":\"LogChecker145EDFD3\"}":{"id":"Output{\"Ref\":\"LogChecker145EDFD3\"}","path":"WebFunctionCopyLogRedactionStack/Exports/Output{\"Ref\":\"LogChecker145EDFD3\"}","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"0.0.0"}}}},"BootstrapVersion":{"id":"BootstrapVersion","path":"WebFunctionCopyLogRedactionStack/BootstrapVersion","constructInfo":{"fqn":"aws-cdk-lib.CfnParameter","version":"0.0.0"}},"CheckBootstrapVersion":{"id":"CheckBootstrapVersion","path":"WebFunctionCopyLogRedactionStack/CheckBootstrapVersion","constructInfo":{"fqn":"aws-cdk-lib.Cfn