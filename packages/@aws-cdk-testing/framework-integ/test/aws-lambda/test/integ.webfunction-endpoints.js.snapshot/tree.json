statusCode); })\n      .on('error', reject);\n  });\n  return { status };\n};\n"},"handler":"index.handler","role":{"Fn::GetAtt":["SignerServiceRole18A0DCD3","Arn"]},"runtime":"nodejs22.x","timeout":30}}},"LogGroup":{"id":"LogGroup","path":"WebFunctionEndpointsStack/Signer/LogGroup","constructInfo":{"fqn":"aws-cdk-lib.aws_logs.LogGroup","version":"0.0.0"},"children":{"Resource":{"id":"Resource","path":"WebFunctionEndpointsStack/Signer/LogGroup/Resource","constructInfo":{"fqn":"aws-cdk-lib.aws_logs.CfnLogGroup","version":"0.0.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::Logs::LogGroup","aws:cdk:cloudformation:logicalId":"SignerLogGroup0DE99B5E","aws:cdk:cloudformation:props":{"logGroupName":{"Fn::Join":["",["/aws/lambda/",{"Ref":"Signer046C0E68"}]]},"retentionInDays":731}}}}}}},"Exports":{"id":"Exports","path":"WebFunctionEndpointsStack/Exports","constructInfo":{"fqn":"constructs.Construct","version":"10.8.1"},"children":{"Output{\"Ref\":\"Signer046C0E68\"}":{"id":"Output{\"Ref\":\"Signer046C0E68\"}","path":"WebFunctionEndpointsStack/Exports/Output{\"Ref\":\"Signer046C0E68\"}","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"0.0.0"}},"Output{\"Fn::GetAtt\":[\"FunctionEndpoint85BE574A\",\"DomainName\"]}":{"id":"Output{\"Fn::GetAtt\":[\"FunctionEndpoint85BE574A\",\"DomainName\"]}","path":"WebFunctionEndpointsStack/Exports/Output{\"Fn::GetAtt\":[\"FunctionEndpoint85BE574A\",\"DomainName\"]}","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"0.0.0"}},"Output{\"Fn::GetAtt\":[\"FunctionMultiRegion7EEB9354\",\"DomainName\"]}":{"id":"Output{\"Fn::GetAtt\":[\"FunctionMultiRegion7EEB9354\",\"DomainName\"]}","path":"WebFunctionEndpointsStack/Exports/Output{\"Fn::GetAtt\":[\"FunctionMultiRegion7EEB9354\",\"DomainName\"]}","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"0.0.0"}},"Output{\"Fn::GetAtt\":[\"FunctionPerRegion025706AB\",\"DomainName\"]}":{"id":"Output{\"Fn::GetAtt\":[\"FunctionPerRegion025706AB\",\"DomainName\"]}","path":"WebFunctio