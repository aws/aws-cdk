zDate.slice(0, 8);\n  const headers = {\n    'content-type': 'application/x-amz-json-1.1',\n    'host': host,\n    'x-amz-date': amzDate,\n    'x-amz-security-token': process.env.AWS_SESSION_TOKEN,\n    'x-amz-target': 'AmazonEC2ContainerServiceV20141113.' + action,\n  };\n  const names = Object.keys(headers).sort();\n  const canonical = ['POST', '/', '', names.map((n) => n + ':' + headers[n] + '\\n').join(''), names.join(';'), sha256(body)].join('\\n');\n  const scope = date + '/' + region + '/ecs/aws4_request';\n  const toSign = ['AWS4-HMAC-SHA256', amzDate, scope, sha256(canonical)].join('\\n');\n  const key = hmac(hmac(hmac(hmac('AWS4' + process.env.AWS_SECRET_ACCESS_KEY, date), region), 'ecs'), 'aws4_request');\n  const signature = crypto.createHmac('sha256', key).update(toSign).digest('hex');\n  delete headers.host;\n  headers.authorization = 'AWS4-HMAC-SHA256 Credential=' + process.env.AWS_ACCESS_KEY_ID + '/' + scope\n    + ', SignedHeaders=' + names.join(';') + ', Signature=' + signature;\n  const response = await fetch('https://' + host + '/', { method: 'POST', headers, body });\n  const result = await response.json();\n  if (!response.ok) throw new Error(action + ' failed: ' + JSON.stringify(result));\n  return result;\n}\n\nexports.handler = async () => {\n  const described = await ecs('DescribeServices', { cluster: process.env.CLUSTER, services: [process.env.SERVICE] });\n  const revisionArn = described.services[0].currentServiceRevisions[0].arn;\n  const revisions = await ecs('DescribeServiceRevisions', { serviceRevisionArns: [revisionArn] });\n  const revision = revisions.serviceRevisions[0];\n  const connector = (revision.gatewayConnectors || [])[0] || {};\n  const connection = ((revision.ecsManagedResources || {}).gatewayConnections || [])[0] || {};\n  let http = 'none';\n  if (connection.status === 'ACTIVE') {\n    try {\n      http = String((await fetch(connection.serviceUrl)).status);\n    } catch (e) {\n      // DNS for a new hostname can take a few minutes after the connection is active\n      http = (e.cause && e.cause.code) || 'error';\n    }\n  }\n  return [connector.portName, (connector.deregistrationDelay || {}).timeoutSeconds, connection.status, connection.accessType, http].join(' ');\n};\n"},"environment":{"variables":{"CLUSTER":{"Ref":"ClusterEB0386A7"},"SERVICE":{"Fn::GetAtt":["ServiceD69D759B","Name"]}}},"handler":"index.handler","role":{"Fn::GetAtt":["CheckGatewayServiceRoleFD70DCEA","Arn"]},"runtime":"nodejs24.x","timeout":30}}},"LogGroup":{"id":"LogGroup","path":"aws-ecs-gateway/CheckGateway/LogGroup","constructInfo":{"fqn":"aws-cdk-lib.aws_logs.LogGroup","version":"0.0.0"},"children":{"Resource":{"id":"Resource","path":"aws-ecs-gateway/CheckGateway/LogGroup/Resource","constructInfo":{"fqn":"aws-cdk-lib.aws_logs.CfnLogGroup","version":"0.0.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::Logs::LogGroup","aws:cdk:cloudformation:logicalId":"CheckGatewayLogGroupDE49C427","aws:cdk:cloudformation:props":{"logGroupName":{"Fn::Join":["",["/aws/lambda/",{"Ref":"CheckGatewayE8FFB45C"}]]},"retentionInDays":731}}}}}}},"Exports":{"id":"Exports","path":"aws-ecs-gateway/Exports","constructInfo":{"fqn":"constructs.Construct","version":"10.8.1"},"children":{"Output{\"Ref\":\"ClusterEB0386A7\"}":{"id":"Output{\"Ref\":\"ClusterEB0386A7\"}","path":"aws-ecs-gateway/Exports/Output{\"Ref\":\"ClusterEB0386A7\"}","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"0.0.0"}},"Output{\"Fn::GetAtt\":[\"ServiceD69D759B\",\"Name\"]}":{"id":"Output{\"Fn::GetAtt\":[\"ServiceD69D759B\",\"Name\"]}","path":"aws-ecs-gateway/Exports/Output{\"Fn::GetAtt\":[\"ServiceD69D759B\",\"Name\"]}","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"0.0.0"}},"Output{\"Ref\":\"CheckGatewayE8FFB45C\"}":{"id":"Output{\"Ref\":\"CheckGatewayE8FFB45C\"}","path":"aws-ecs-gateway/Exports/Output{\"Ref\":\"CheckGatewayE8FFB45C\"}","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"0.0.0"}}}},"BootstrapVersion":{"id":"BootstrapV