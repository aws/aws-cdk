{
  "/cloudfront-custom-s3-stack": [
    {
      "type": "aws:cdk:templateFile",
      "data": "cloudfront-custom-s3-stack.template.json"
    }
  ],
  "/cloudfront-custom-s3-stack/Bucket": [
    {
      "type": "aws:cdk:analytics:construct",
      "data": {
        "websiteIndexDocument": "*",
        "websiteErrorDocument": "*",
        "removalPolicy": "destroy",
        "autoDeleteObjects": true
      }
    }
  ],
  "/cloudfront-custom-s3-stack/Custom::S3AutoDeleteObjectsCustomResourceProvider": [
    {
      "type": "aws:cdk:is-custom-resource-handler-customResourceProvider",
      "data": true
    }
  ],
  "/cloudfront-custom-s3-stack/Distribution": [
    {
      "type": "aws:cdk:analytics:construct",
      "data": {
        "viewerProtocolPolicy": "redirect-to-https",
        "priceClass": "PriceClass_200",
        "originConfigs": [
          {
            "behaviors": [
              {
                "isDefaultBehavior": true
              }
            ],
            "customOriginSource": {
              "originProtocolPolicy": "http-only",
              "domainName": "*"
            }
          }
        ]
      }
    }
  ],
  "/cloudfront-custom-s3-stack/BootstrapVersion": [
    {
      "type": "aws:cdk:logicalId",
      "data": "BootstrapVersion"
    }
  ],
  "/cloudfront-custom-s3-stack/CheckBootstrapVersion": [
