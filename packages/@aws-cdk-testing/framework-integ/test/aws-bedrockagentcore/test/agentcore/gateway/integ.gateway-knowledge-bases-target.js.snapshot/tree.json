n","version":"0.0.0"},"children":{"ServiceRole":{"id":"ServiceRole","path":"cdk-agentcore-gateway-knowledge-bases-target/ToolCaller/ServiceRole","constructInfo":{"fqn":"aws-cdk-lib.aws_iam.Role","version":"0.0.0"},"children":{"Resource":{"id":"Resource","path":"cdk-agentcore-gateway-knowledge-bases-target/ToolCaller/ServiceRole/Resource","constructInfo":{"fqn":"aws-cdk-lib.aws_iam.CfnRole","version":"0.0.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::IAM::Role","aws:cdk:cloudformation:logicalId":"ToolCallerServiceRole7CED933D","aws:cdk:cloudformation:props":{"assumeRolePolicyDocument":{"Statement":[{"Action":"sts:AssumeRole","Effect":"Allow","Principal":{"Service":"lambda.amazonaws.com"}}],"Version":"2012-10-17"},"managedPolicyArns":[{"Fn::Join":["",["arn:",{"Ref":"AWS::Partition"},":iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"]]}]}}},"DefaultPolicy":{"id":"DefaultPolicy","path":"cdk-agentcore-gateway-knowledge-bases-target/ToolCaller/ServiceRole/DefaultPolicy","constructInfo":{"fqn":"aws-cdk-lib.aws_iam.Policy","version":"0.0.0"},"children":{"Resource":{"id":"Resource","path":"cdk-agentcore-gateway-knowledge-bases-target/ToolCaller/ServiceRole/DefaultPolicy/Resource","constructInfo":{"fqn":"aws-cdk-lib.aws_iam.CfnPolicy","version":"0.0.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::IAM::Policy","aws:cdk:cloudformation:logicalId":"ToolCallerServiceRoleDefaultPolicy9D36356D","aws:cdk:cloudformation:props":{"policyDocument":{"Statement":[{"Action":"cognito-idp:DescribeUserPoolClient","Effect":"Allow","Resource":{"Fn::GetAtt":["GatewayUserPoolAC9C51BE","Arn"]}}],"Version":"2012-10-17"},"policyName":"ToolCallerServiceRoleDefaultPolicy9D36356D","roles":[{"Ref":"ToolCallerServiceRole7CED933D"}]}}}}}}},"Resource":{"id":"Resource","path":"cdk-agentcore-gateway-knowledge-bases-target/ToolCaller/Resource","constructInfo":{"fqn":"aws-cdk-lib.aws_lambda.CfnFunction","version":"0.0.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::Lambda::Function","aws:cdk:cloudformation:logicalId":"ToolCallerED5CBE22","aws:cdk:cloudformation:props":{"code":{"zipFile":"\nconst { CognitoIdentityProviderClient, DescribeUserPoolClientCommand } = require('@aws-sdk/client-cognito-identity-provider');\n\nconst EXPECTED_TOOLS = [\n  'managed-kb___AgenticRetrieveStream',\n  'managed-kb___Retrieve',\n  'managed-kb-retrieve___Retrieve',\n  'web-search___WebSearch',\n];\nconst CALLS = {\n  'managed-kb___AgenticRetrieveStream': { messages: [{ role: 'user', content: { text: 'What do the documents cover?' } }] },\n  'managed-kb___Retrieve': { retrievalQuery: { text: 'What do the documents cover?' } },\n  'managed-kb-retrieve___Retrieve': { retrievalQuery: { text: 'What do the documents cover?' } },\n  'web-search___WebSearch': { query: 'AWS CDK' },\n};\n\nasync function rpc(token, id, method, params) {\n  const response = await fetch(process.env.GATEWAY_URL, {\n    method: 'POST',\n    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json', 'Accept': 'application/json, text/event-stream' },\n    body: JSON.stringify({ jsonrpc: '2.0', id, method, params }),\n  });\n  const text = await response.text();\n  if (!response.ok) { return { error: { code: response.status, message: text.slice(0, 500) } }; }\n  if ((response.headers.get('content-type') || '').startsWith('text/event-stream')) {\n    const messages = text.split('\\n').filter(l => l.startsWith('data:')).map(l => JSON.parse(l.slice(5)));\n    return messages.filter(m => m.id === id).pop() || { error: { message: 'no response' } };\n  }\n  return JSON.parse(text);\n}\n\nexports.handler = async () => {\n  const cognito = new CognitoIdentityProviderClient({});\n  const client = await cognito.send(new DescribeUserPoolClientCommand({ UserPoolId: process.env.USER_POOL_ID, ClientId: process.env.CLIENT_ID }));\n  const basic = Buffer.from(process.env.CLIENT_ID + ':' + client.UserPoolClient.ClientSecret).toString('base64');\n  const tokenResponse = await fetch(process.env.TOKEN_ENDPOINT, {\n    method: 'POST',\n    headers: { 'Authorization': 'Basic ' + basic, 'Content-Type': 'application/x-www-form-urlencoded' },\n    body: new URLSearchParams({ grant_type: 'client_credentials', scope: process.env.SCOPES }).toString(),\n  });\n  const token = (await tokenResponse.json()).access_token;\n\n  const list = await rpc(token, 1, 'tools/list', {});\n  const tools = ((list.result && list.result.tools) || []).map(t => t.name).filter(n => !n.startsWith('x_amz_bedrock_agentcore_')).sort();\n  const toolsMatch = JSON.stringify(tools) === JSON.stringify([...EXPECTED_TOOLS].sort());\n\n  const calls = {};\n  let id = 10;\n  for (const [name, args] of Object.entries(CALLS)) {\n    const response = await rpc(token, id++, 'tools/call', { name, arguments: args });\n    const failed = response.error || !response.result || response.result.isError;\n    calls[name] = failed ? JSON.stringify(response.error || response.result).slice(0, 500) : 'ok';\n  }\n\n  const allSucceeded = toolsMatch && Object.values(calls).every(v => v === 'ok');\n  return { allSucceeded, tools, calls };\n};\n"},"environment":{"variables":{"GATEWAY_URL":{"Fn::GetAtt":["Gateway43CB3636","GatewayUrl"]},"TOKEN_ENDPOINT":{"Fn::Join":["",["https://",{"Ref":"GatewayUserPoolDomainCD8A1197"},".auth.",{"Ref":"AWS::Region"},".amazoncognito.com/oauth2/token"]]},"USER_POOL_ID":{"Ref":"GatewayUserPoolAC9C51BE"},"CLIENT_ID":{"Ref":"GatewayUserPoolDefaultClient48FC6ADE"},"SCOPES":{"Fn::Join":["",[{"Ref":"GatewayUserPoolResourceServerA9AA7EAD"},"/read ",{"Ref":"GatewayUserPoolResourceServerA9AA7EAD"},"/write"]]}}},"handler":"index.handler","role":{"Fn::GetAtt":["ToolCallerServiceRole7CED933D","Arn"]},"runtime":"nodejs22.x","timeout":300}}},"LogGroup":{"id":"LogGroup","path":"cdk-agentcore-gateway-knowledge-bases-target/ToolCaller/LogGroup","constructInfo":{"fqn":"aws-cdk-lib.aws_logs.LogGroup","version":"0.0.0"},"children":{"Resource":{"id":"Resource","path":"cdk-agentcore-gateway-knowledge-bas